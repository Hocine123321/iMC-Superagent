+        s.look_speed = 4;
+        s.stick_size = 3;
+        s.move_zone = 3;
+        s.hold_time = 0;
+        s.double_tap_jump = true;
+        s.apply(&mut t);
+        assert_eq!(t.feel.look_degrees_per_px, 0.20);
+        assert_eq!(t.layout.stick_radius, 0.22);
+        assert_eq!(t.layout.move_zone, 0.60);
+        assert_eq!(t.feel.tap_secs, 0.15);
+        assert!(t.double_tap_jump);
+    }
