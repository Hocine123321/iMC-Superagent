+        assert!(!t.sprinting(), "sideways");
+    }
+
+    #[test]
+    fn lifting_the_steering_finger_stops_the_sprint() {
+        let mut t = touch();
+        t.down(1, (300.0, 800.0), 0.0, &[]);
+        let radius = t.layout.stick_radius * 1170.0;
