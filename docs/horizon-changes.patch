+/// The editor's panel, version two: collapsible, with sliders. Pure geometry and slider maths.
+pub mod panel2 {
+    use crate::touch_layout::{MAX_SCALE, MIN_OPACITY, MIN_SCALE};
+
+    /// What the panel's controls do.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub enum Control {
+        /// The tab that folds the panel away or brings it back.
+        Fold,
+        /// The size slider's track.
+        SizeSlider,
+        /// The fade (opacity) slider's track.
+        FadeSlider,
+        ToggleShown,
+        /// Snapping to the grid on or off (edges and other buttons always pull).
+        ToggleSnap,
+        /// Step to the next layout in the list.
+        NextPreset,
+        /// Keep the arrangement under the name shown.
+        SavePreset,
+        /// Forget the saved layout shown.
+        DeletePreset,
+        ResetButton,
+        ResetAll,
+        Cancel,
+        Done,
+    }
+
+    pub const OPEN_W: f32 = 150.0;
+    /// The tab a folded panel leaves, wide enough for a thumb.
+    pub const TAB_W: f32 = 26.0;
+    pub const ROW_H: f32 = 20.0;
+    pub const GAP: f32 = 3.0;
+
+    /// The width the panel takes: the tab alone when folded.
+    pub fn width(open: bool) -> f32 {
+        if open { OPEN_W } else { TAB_W }
+    }
+
+    /// The stage: the width left of the panel.
+    pub fn stage_width(size: (f32, f32), open: bool) -> f32 {
+        size.0 - width(open)
+    }
+
+    /// The controls with their places `(control, [x, y, w, h])`. Folded, only the tab; open, the
+    /// tab is a strip down the panel's left edge and the rest sit to its right.
+    pub fn layout(size: (f32, f32), open: bool) -> Vec<(Control, [f32; 4])> {
+        let left = size.0 - width(open);
+        let mut out = vec![(Control::Fold, [left, 0.0, TAB_W, size.1])];
+        if !open {
+            return out;
+        }
+        let x = left + TAB_W + GAP;
+        let inner = OPEN_W - TAB_W - 2.0 * GAP;
+        let half = (inner - GAP) / 2.0;
+        // Below the heading and the picked button's name.
+        let mut y = GAP + 18.0;
+        // Rows: the two sliders, then pairs, so ten controls fit a small phone's height.
+        for c in [Control::SizeSlider, Control::FadeSlider, Control::NextPreset] {
+            out.push((c, [x, y, inner, ROW_H]));
+            y += ROW_H + GAP;
+        }
+        let pairs = [
+            (Control::ToggleShown, Control::ToggleSnap),
+            (Control::SavePreset, Control::DeletePreset),
+            (Control::ResetButton, Control::ResetAll),
+        ];
+        for (a, b) in pairs {
+            out.push((a, [x, y, half, ROW_H]));
+            out.push((b, [x + half + GAP, y, half, ROW_H]));
+            y += ROW_H + GAP;
+        }
+        // Done and Cancel at the bottom, where a thumb rests.
+        let bottom = size.1 - GAP - ROW_H;
+        out.push((Control::Done, [x + half + GAP, bottom, half, ROW_H]));
+        out.push((Control::Cancel, [x, bottom, half, ROW_H]));
+        out
+    }
+
+    /// The control under `at`.
+    pub fn control_at(size: (f32, f32), open: bool, at: (f32, f32)) -> Option<Control> {
+        layout(size, open).into_iter().find_map(|(c, r)| {
+            (at.0 >= r[0] && at.0 < r[0] + r[2] && at.1 >= r[1] && at.1 < r[1] + r[3]).then_some(c)
+        })
+    }
+
+    /// Where along a track `[x, y, w, h]` the finger is, 0 at the left end and 1 at the right.
+    pub fn track_fraction(track: [f32; 4], at_x: f32) -> f32 {
+        if track[2] <= 0.0 {
+            return 0.0;
+        }
+        ((at_x - track[0]) / track[2]).clamp(0.0, 1.0)
+    }
+
+    /// The size a track fraction means, in 5 % steps so the number is easy to read and repeat.
+    pub fn scale_at(fraction: f32) -> f32 {
+        let raw = MIN_SCALE + fraction.clamp(0.0, 1.0) * (MAX_SCALE - MIN_SCALE);
+        ((raw * 20.0).round() / 20.0).clamp(MIN_SCALE, MAX_SCALE)
+    }
+
+    /// The opacity a track fraction means, in 5 % steps.
+    pub fn opacity_at(fraction: f32) -> f32 {
+        let raw = MIN_OPACITY + fraction.clamp(0.0, 1.0) * (1.0 - MIN_OPACITY);
+        ((raw * 20.0).round() / 20.0).clamp(MIN_OPACITY, 1.0)
+    }
+
+    /// The inverse: where on the track a size sits, for drawing the handle.
+    pub fn scale_fraction(scale: f32) -> f32 {
+        ((scale - MIN_SCALE) / (MAX_SCALE - MIN_SCALE)).clamp(0.0, 1.0)
+    }
+
+    pub fn opacity_fraction(opacity: f32) -> f32 {
+        ((opacity - MIN_OPACITY) / (1.0 - MIN_OPACITY)).clamp(0.0, 1.0)
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        const PHONE: (f32, f32) = (633.0, 292.5);
+        const SMALL: (f32, f32) = (427.0, 240.0);
+
+        fn overlaps(a: [f32; 4], b: [f32; 4]) -> bool {
+            crate::touch_editor_tools::overlap(a, b)
+        }
+
+        #[test]
+        fn folded_leaves_only_the_tab_and_the_stage_gets_the_screen() {
+            let l = layout(PHONE, false);
+            assert_eq!(l.len(), 1);
+            assert_eq!(l[0].0, Control::Fold);
+            assert_eq!(stage_width(PHONE, false), PHONE.0 - TAB_W);
+            assert!(stage_width(PHONE, false) > stage_width(PHONE, true));
+        }
+
+        #[test]
+        fn open_every_control_fits_the_screen_and_none_overlap() {
+            for size in [PHONE, SMALL, (320.0, 240.0)] {
+                let l = layout(size, true);
+                for (c, r) in &l {
+                    assert!(r[0] >= 0.0 && r[1] >= 0.0, "{c:?} {size:?}");
+                    assert!(r[0] + r[2] <= size.0 + 0.01, "{c:?} {size:?}");
+                    assert!(r[1] + r[3] <= size.1 + 0.01, "{c:?} {size:?}");
+                }
+                for (i, (ca, a)) in l.iter().enumerate() {
+                    for (cb, b) in &l[i + 1..] {
+                        assert!(!overlaps(*a, *b), "{ca:?} and {cb:?} overlap on {size:?}");
+                    }
+                }
+            }
+        }
+
+        #[test]
+        fn every_control_is_there_once_when_open() {
+            let l = layout(PHONE, true);
+            for c in [
+                Control::Fold,
+                Control::SizeSlider,
+                Control::FadeSlider,
+                Control::ToggleShown,
+                Control::ToggleSnap,
+                Control::NextPreset,
+                Control::SavePreset,
+                Control::DeletePreset,
+                Control::ResetButton,
+                Control::ResetAll,
+                Control::Cancel,
+                Control::Done,
+            ] {
+                assert_eq!(l.iter().filter(|(x, _)| *x == c).count(), 1, "{c:?}");
+            }
+        }
+
+        #[test]
+        fn controls_are_thumb_sized() {
+            for (c, r) in layout(PHONE, true) {
+                let min = if c == Control::Fold { r[2] } else { r[3] };
+                assert!(min >= 20.0, "{c:?} is {min} units");
+            }
+        }
+
+        #[test]
+        fn a_touch_finds_its_control_and_the_stage_finds_none() {
+            let (c, r) = layout(PHONE, true)[1];
+            assert_eq!(control_at(PHONE, true, (r[0] + 1.0, r[1] + 1.0)), Some(c));
+            assert_eq!(control_at(PHONE, true, (10.0, 10.0)), None);
+            assert_eq!(
+                control_at(PHONE, false, (PHONE.0 - 5.0, 100.0)),
+                Some(Control::Fold)
+            );
+        }
+
+        #[test]
+        fn a_track_reads_zero_to_one_and_holds_past_its_ends() {
+            let t = [100.0, 0.0, 80.0, 20.0];
+            assert_eq!(track_fraction(t, 100.0), 0.0);
+            assert_eq!(track_fraction(t, 140.0), 0.5);
+            assert_eq!(track_fraction(t, 180.0), 1.0);
+            assert_eq!(track_fraction(t, 0.0), 0.0);
+            assert_eq!(track_fraction(t, 999.0), 1.0);
+            assert_eq!(track_fraction([0.0, 0.0, 0.0, 1.0], 5.0), 0.0);
+        }
+
+        #[test]
+        fn sliders_reach_both_limits_and_move_in_five_percent_steps() {
+            assert_eq!(scale_at(0.0), MIN_SCALE);
+            assert_eq!(scale_at(1.0), MAX_SCALE);
+            assert_eq!(opacity_at(0.0), MIN_OPACITY);
+            assert_eq!(opacity_at(1.0), 1.0);
+            for i in 0..=100 {
+                let f = i as f32 / 100.0;
+                for v in [scale_at(f), opacity_at(f)] {
+                    assert!(((v * 20.0).round() - v * 20.0).abs() < 1e-3, "{v}");
+                }
+                assert!(scale_at(f) >= MIN_SCALE && scale_at(f) <= MAX_SCALE);
+                assert!(opacity_at(f) >= MIN_OPACITY && opacity_at(f) <= 1.0);
+            }
+        }
+
+        #[test]
+        fn the_handle_sits_where_the_value_is() {
+            for s in [0.5_f32, 0.8, 1.0, 1.5, 2.0] {
+                assert!((scale_at(scale_fraction(s)) - s).abs() < 0.03, "{s}");
+            }
+            for o in [0.15_f32, 0.5, 1.0] {
+                assert!((opacity_at(opacity_fraction(o)) - o).abs() < 0.03, "{o}");
+            }
+            assert_eq!(scale_fraction(0.0), 0.0);
+            assert_eq!(scale_fraction(9.0), 1.0);
+        }
+
+        #[test]
+        fn the_default_size_and_fade_are_reachable_exactly() {
+            assert_eq!(scale_at(scale_fraction(1.0)), 1.0);
+            assert_eq!(opacity_at(opacity_fraction(1.0)), 1.0);
+        }
+    }
+}
+
+#[cfg(test)]
+mod iphone12 {
+    use super::panel2::*;
+
+    /// An iPhone 12 in landscape at GUI scale 2 is about 422 x 195 units: shorter than the
+    /// sizes tested above, and the one the owner plays on.
+    #[test]
+    fn the_open_panel_fits_an_iphone_12_in_landscape() {
+        let size = (422.0, 195.0);
+        let l = layout(size, true);
+        for (c, r) in &l {
+            assert!(r[0] >= 0.0 && r[1] >= 0.0, "{c:?}");
+            assert!(r[0] + r[2] <= size.0 + 0.01 && r[1] + r[3] <= size.1 + 0.01, "{c:?} {r:?}");
+        }
+        for (i, (ca, a)) in l.iter().enumerate() {
+            for (cb, b) in &l[i + 1..] {
+                assert!(!crate::touch_editor_tools::overlap(*a, *b), "{ca:?} and {cb:?}");
+            }
+        }
+    }
+}
diff --git a/horizon/crates/horizon-client-input/src/touch_extras.rs b/horizon/crates/horizon-client-input/src/touch_extras.rs
new file mode 100644
index 0000000..420641c
--- /dev/null
+++ b/horizon/crates/horizon-client-input/src/touch_extras.rs
@@ -0,0 +1,378 @@
+//! The extra on-screen buttons: Chat, F3, F2, View and two keys the player picks.
+//!
+//! Each one presses a key of the game, by the name of the binding, so the player's own choice
+//! counts: Chat presses whatever `key.chat` is bound to, not a hard-coded T. A button is drawn
+//! and answers a touch only once it is switched on; where it sits and how big it is comes from
+//! the layout (`touch_layout`), like the nine that are always there.
+//!
+//! Pure: the file's text, the names and the checks. The game presses the key
+//! (`horizon-client`). Kept in `horizon-imc-buttons.txt`, written only once something is changed.
+
+/// The file, beside `options.txt`.
+pub const FILE: &str = "horizon-imc-buttons.txt";
+
+/// One of the extra buttons.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Extra {
+    Chat,
+    Debug,
+    Screenshot,
+    View,
+    Key1,
+    Key2,
+}
+
+impl Extra {
+    pub const ALL: [Extra; 6] = [
+        Extra::Chat,
+        Extra::Debug,
+        Extra::Screenshot,
+        Extra::View,
+        Extra::Key1,
+        Extra::Key2,
+    ];
+
+    /// The name in the file, and the button's name in the layout file.
+    pub fn name(self) -> &'static str {
+        match self {
+            Extra::Chat => "chat",
+            Extra::Debug => "debug",
+            Extra::Screenshot => "shot",
+            Extra::View => "view",
+            Extra::Key1 => "key1",
+            Extra::Key2 => "key2",
+        }
+    }
+
+    /// What the button shows by default.
+    pub fn label(self) -> &'static str {
+        match self {
+            Extra::Chat => "Chat",
+            Extra::Debug => "F3",
+            Extra::Screenshot => "F2",
+            Extra::View => "View",
+            Extra::Key1 => "Key 1",
+            Extra::Key2 => "Key 2",
+        }
+    }
+
+    /// The game's binding this button presses, or `None` for the two the player picks.
+    pub fn binding(self) -> Option<&'static str> {
+        match self {
+            Extra::Chat => Some("key.chat"),
+            Extra::Debug => Some("key.debug.overlay"),
+            Extra::Screenshot => Some("key.screenshot"),
+            Extra::View => Some("key.togglePerspective"),
+            Extra::Key1 | Extra::Key2 => None,
+        }
+    }
+
+    fn index(self) -> usize {
+        Self::ALL.iter().position(|e| *e == self).unwrap_or(0)
+    }
+}
+
+/// Which extras are on, and the two keys.
+#[derive(Clone, Debug, PartialEq, Eq, Default)]
+pub struct Extras {
+    on: [bool; 6],
+    /// The game's key name (`key.keyboard.g`) the two picked buttons press, or empty.
+    keys: [String; 2],
+}
+
+impl Extras {
+    pub fn is_on(&self, e: Extra) -> bool {
+        self.on[e.index()]
+    }
+
+    pub fn set_on(&mut self, e: Extra, on: bool) {
+        self.on[e.index()] = on;
+    }
+
+    pub fn toggle(&mut self, e: Extra) {
+        let i = e.index();
+        self.on[i] = !self.on[i];
+    }
+
+    /// A picked button's key name, `""` while none is chosen.
+    pub fn key_of(&self, e: Extra) -> &str {
+        match e {
+            Extra::Key1 => &self.keys[0],
+            Extra::Key2 => &self.keys[1],
+            _ => "",
+        }
+    }
+
+    /// Chooses the key of Key 1 or Key 2. Anything that is not a plain key name is refused, and
+    /// the old choice stays.
+    pub fn set_key(&mut self, e: Extra, name: &str) -> bool {
+        let slot = match e {
+            Extra::Key1 => 0,
+            Extra::Key2 => 1,
+            _ => return false,
+        };
+        if !valid_key_name(name) {
+            return false;
+        }
+        self.keys[slot] = name.to_owned();
+        true
+    }
+
+    /// The buttons that are on and have something to press, in order.
+    pub fn active(&self) -> impl Iterator<Item = Extra> + '_ {
+        Extra::ALL.into_iter().filter(|e| {
+            self.is_on(*e) && (e.binding().is_some() || !self.key_of(*e).is_empty())
+        })
+    }
+
+    pub fn is_default(&self) -> bool {
+        *self == Extras::default()
+    }
+
+    /// The saved text. A button is a line `chat:on`; a picked key adds `key1.key:key.keyboard.g`.
+    pub fn serialize(&self) -> String {
+        let mut out = String::new();
+        for e in Extra::ALL {
+            if self.is_on(e) {
+                out.push_str(&format!("{}:on\n", e.name()));
+            }
+        }
+        for (i, e) in [Extra::Key1, Extra::Key2].into_iter().enumerate() {
+            if !self.keys[i].is_empty() {
+                out.push_str(&format!("{}.key:{}\n", e.name(), self.keys[i]));
+            }
+        }
+        out
+    }
+
+    /// Reads the text. Unknown lines and key names that are not plain are ignored.
+    pub fn parse(text: &str) -> Self {
+        let mut extras = Extras::default();
+        for line in text.lines() {
+            let Some((name, value)) = line.split_once(':') else {
+                continue;
+            };
+            let (name, value) = (name.trim(), value.trim());
+            if let Some(e) = Extra::ALL.into_iter().find(|e| e.name() == name) {
+                extras.set_on(e, value == "on");
+            } else if let Some(base) = name.strip_suffix(".key")
+                && let Some(e) = [Extra::Key1, Extra::Key2]
+                    .into_iter()
+                    .find(|e| e.name() == base)
+            {
+                extras.set_key(e, value);
+            }
+        }
+        extras
+    }
+}
+
+/// The keys Key 1 and Key 2 can be set to: the ones a player is likely to want on a button. A
+/// click on the setting steps to the next, so the page needs no "press a key" screen. Each is a
+/// name the game knows (`keybinds`), and each passes [`valid_key_name`].
+pub const CHOICES: [&str; 24] = [
+    "key.keyboard.f1",
+    "key.keyboard.f4",
+    "key.keyboard.f5",
+    "key.keyboard.f6",
+    "key.keyboard.f7",
+    "key.keyboard.f8",
+    "key.keyboard.f9",
+    "key.keyboard.f10",
+    "key.keyboard.f11",
+    "key.keyboard.g",
+    "key.keyboard.h",
+    "key.keyboard.j",
+    "key.keyboard.k",
+    "key.keyboard.l",
+    "key.keyboard.m",
+    "key.keyboard.n",
+    "key.keyboard.o",
+    "key.keyboard.p",
+    "key.keyboard.u",
+    "key.keyboard.v",
+    "key.keyboard.b",
+    "key.keyboard.x",
+    "key.keyboard.z",
+    "key.keyboard.slash",
+];
+
+/// A key as the page shows it: `key.keyboard.f6` is `F6`, `key.keyboard.g` is `G`, and no key
+/// is `None`.
+pub fn key_caption(name: &str) -> String {
+    match name.strip_prefix("key.keyboard.") {
+        Some(rest) if !rest.is_empty() => rest.replace('.', " ").to_ascii_uppercase(),
+        _ => "None".to_owned(),
+    }
+}
+
+impl Extras {
+    /// Steps Key 1 or Key 2 to the next choice (from none to the first, and after the last back
+    /// to none). A key the file holds that is not among the choices steps to the first.
+    pub fn step_key(&mut self, e: Extra) -> bool {
+        let current = self.key_of(e).to_owned();
+        let next = if current.is_empty() {
+            Some(CHOICES[0])
+        } else {
+            match CHOICES.iter().position(|c| *c == current) {
+                Some(i) => CHOICES.get(i + 1).copied(),
+                None => Some(CHOICES[0]),
+            }
+        };
+        match next {
+            Some(name) => self.set_key(e, name),
+            None => {
+                let slot = if e == Extra::Key1 { 0 } else { 1 };
+                if e != Extra::Key1 && e != Extra::Key2 {
+                    return false;
+                }
+                self.keys[slot].clear();
+                true
+            }
+        }
+    }
+}
+
+/// Whether `name` could be a key of the game: `key.keyboard.` and then lower case letters,
+/// digits, dots and underscores. The game still has the last word on whether it exists; this
+/// keeps a damaged file or a typo from carrying anything odd into a command line.
+pub fn valid_key_name(name: &str) -> bool {
+    name.len() <= 40
+        && name
+            .strip_prefix("key.keyboard.")
+            .is_some_and(|rest| {
+                !rest.is_empty()
+                    && rest
+                        .chars()
+                        .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '.' || c == '_')
+            })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nothing_is_on_until_the_player_switches_it_on() {
+        let extras = Extras::default();
+        assert!(extras.is_default());
+        assert_eq!(extras.active().count(), 0);
+        assert_eq!(extras.serialize(), "");
+        assert_eq!(Extras::parse(""), extras);
+    }
+
+    #[test]
+    fn a_button_is_active_only_when_on_and_it_has_a_key() {
+        let mut extras = Extras::default();
+        extras.set_on(Extra::Chat, true);
+        extras.set_on(Extra::Key1, true);
+        // Key 1 is on but has no key yet: nothing to press, so no button.
+        assert_eq!(extras.active().collect::<Vec<_>>(), vec![Extra::Chat]);
+        assert!(extras.set_key(Extra::Key1, "key.keyboard.g"));
+        assert_eq!(
+            extras.active().collect::<Vec<_>>(),
+            vec![Extra::Chat, Extra::Key1]
+        );
+        extras.toggle(Extra::Chat);
+        assert_eq!(extras.active().collect::<Vec<_>>(), vec![Extra::Key1]);
+    }
+
+    #[test]
+    fn the_fixed_buttons_press_the_players_own_bindings() {
+        assert_eq!(Extra::Chat.binding(), Some("key.chat"));
+        assert_eq!(Extra::Debug.binding(), Some("key.debug.overlay"));
+        assert_eq!(Extra::Screenshot.binding(), Some("key.screenshot"));
+        assert_eq!(Extra::View.binding(), Some("key.togglePerspective"));
+        assert_eq!(Extra::Key1.binding(), None);
+    }
+
+    #[test]
+    fn it_survives_the_file() {
+        let mut extras = Extras::default();
+        extras.set_on(Extra::Debug, true);
+        extras.set_on(Extra::Key2, true);
+        extras.set_key(Extra::Key2, "key.keyboard.left.bracket");
+        extras.set_key(Extra::Key1, "key.keyboard.f6");
+        assert_eq!(Extras::parse(&extras.serialize()), extras);
+        assert!(!extras.is_default());
+    }
+
+    #[test]
+    fn only_plain_key_names_are_taken() {
+        let mut extras = Extras::default();
+        for bad in [
+            "",
+            "g",
+            "key.keyboard.",
+            "key.keyboard.G",
+            "key.keyboard.g tap\nquit",
+            "key.mouse.left",
+            "key.keyboard.a;b",
+            &format!("key.keyboard.{}", "x".repeat(40)),
+        ] {
+            assert!(!extras.set_key(Extra::Key1, bad), "{bad:?}");
+        }
+        assert_eq!(extras.key_of(Extra::Key1), "");
+        assert!(!extras.set_key(Extra::Chat, "key.keyboard.g"), "Chat's key is not picked");
+        // A bad line in the file is dropped and the rest is read.
+        let read = Extras::parse("chat:on\nkey1.key:key.keyboard.g\nkey2.key:quit\nnonsense\nfoo:on");
+        assert!(read.is_on(Extra::Chat));
+        assert_eq!(read.key_of(Extra::Key1), "key.keyboard.g");
+        assert_eq!(read.key_of(Extra::Key2), "");
+    }
+
+    #[test]
+    fn every_choice_is_a_valid_name_the_game_knows_and_none_twice() {
+        for (i, c) in CHOICES.iter().enumerate() {
+            assert!(valid_key_name(c), "{c}");
+            assert!(CHOICES[i + 1..].iter().all(|o| o != c), "{c} is listed twice");
+        }
+    }
+
+    #[test]
+    fn the_game_knows_every_choice() {
+        // An unknown name would press nothing, silently.
+        for c in CHOICES {
+            assert!(crate::keybinds::key_code(c).is_some(), "{c} is not a key of the game");
+        }
+    }
+
+    #[test]
+    fn stepping_goes_through_every_choice_and_back_to_none() {
+        let mut extras = Extras::default();
+        assert_eq!(extras.key_of(Extra::Key1), "");
+        for c in CHOICES {
+            assert!(extras.step_key(Extra::Key1));
+            assert_eq!(extras.key_of(Extra::Key1), c);
+        }
+        assert!(extras.step_key(Extra::Key1));
+        assert_eq!(extras.key_of(Extra::Key1), "");
+        // Key 2 is its own; the fixed buttons have no key to step.
+        assert_eq!(extras.key_of(Extra::Key2), "");
+        assert!(!extras.step_key(Extra::Chat));
+    }
+
+    #[test]
+    fn a_key_not_among_the_choices_steps_to_the_first() {
+        let mut extras = Extras::parse("key2.key:key.keyboard.left.bracket\n");
+        assert_eq!(extras.key_of(Extra::Key2), "key.keyboard.left.bracket");
+        assert!(extras.step_key(Extra::Key2));
+        assert_eq!(extras.key_of(Extra::Key2), CHOICES[0]);
+    }
+
+    #[test]
+    fn keys_are_shown_by_their_plain_name() {
+        assert_eq!(key_caption("key.keyboard.f6"), "F6");
+        assert_eq!(key_caption("key.keyboard.g"), "G");
+        assert_eq!(key_caption("key.keyboard.left.bracket"), "LEFT BRACKET");
+        assert_eq!(key_caption(""), "None");
+    }
+
+    #[test]
+    fn every_extra_has_its_own_name_and_a_label() {
+        for (i, a) in Extra::ALL.iter().enumerate() {
+            assert!(!a.label().is_empty() && !a.name().contains([':', ',', '.', '\n']));
+            assert!(Extra::ALL[i + 1..].iter().all(|b| a.name() != b.name()));
+        }
+    }
+}
diff --git a/horizon/crates/horizon-client-input/src/touch_layout.rs b/horizon/crates/horizon-client-input/src/touch_layout.rs
new file mode 100644
index 0000000..83dfc58
--- /dev/null
+++ b/horizon/crates/horizon-client-input/src/touch_layout.rs
@@ -0,0 +1,728 @@
+//! The player's own arrangement of the on-screen buttons, as pure data: no winit, no game state.
+//!
+//! Each button keeps only what the player changed, as a nudge from where the layout puts it
+//! (`game/touch.rs`'s `PADS`): a move in fractions of the screen, a size factor, an opacity and
+//! whether it shows. Kept as a nudge and not as a position so that
+//!
+//! - a layout nobody edited is exactly the layout touch had before it could be edited,
+//! - iMC Settings' Screen margin still moves the buttons that follow the safe edges,
+//! - a saved layout still fits another phone or a turned screen (fractions, not pixels).
+//!
+//! The file is `horizon-touch-layout.txt` beside `horizon-imc.txt`: one line per button,
+//! `name:dx,dy,scale,opacity,shown`, written only when something differs from the default.
+
+/// How many buttons can be arranged (the nine pads, Back, and the six extras).
+pub const COUNT: usize = 16;
+
+/// Where the extras start in [`NAMES`]; they follow `touch_extras::Extra::ALL` in order.
+pub const EXTRA_FIRST: usize = 10;
+
+/// The buttons by their saved name, in the order they are listed and drawn. New ones go on the
+/// end, so a file saved by an older version still reads the same.
+pub const NAMES: [&str; COUNT] = [
+    "jump", "sneak", "run", "use", "pause", "prev", "next", "drop", "inv", "back", "chat",
+    "debug", "shot", "view", "key1", "key2",
+];
+
+/// Largest move from the default, as a fraction of the screen's width or height. Enough to put a
+/// button anywhere on screen from any corner without letting it be lost off the edge.
+pub const MAX_MOVE: f32 = 1.0;
+/// Smallest and largest size factor.
+pub const MIN_SCALE: f32 = 0.5;
+pub const MAX_SCALE: f32 = 2.0;
+/// An opacity below this is hard to find and press, so it is not offered.
+pub const MIN_OPACITY: f32 = 0.15;
+
+/// One button's arrangement.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Slot {
+    /// Move from the default, as fractions of the screen's width and height. Right and down are
+    /// positive.
+    pub dx: f32,
+    pub dy: f32,
+    /// Size factor around the button's centre: 1.0 is the default size.
+    pub scale: f32,
+    /// How opaque it is drawn, 0 to 1. A button that is drawn faintly still answers a touch.
+    pub opacity: f32,
+    /// Hidden buttons are neither drawn nor pressable.
+    pub shown: bool,
+}
+
+impl Default for Slot {
+    fn default() -> Self {
+        Slot {
+            dx: 0.0,
+            dy: 0.0,
+            scale: 1.0,
+            opacity: 1.0,
+            shown: true,
+        }
+    }
+}
+
+impl Slot {
+    /// This slot with every value brought into the range the editor allows. A saved file can hold
+    /// anything, including NaN, so each value is checked.
+    pub fn clamped(self) -> Slot {
+        let fix = |v: f32, lo: f32, hi: f32, fallback: f32| {
+            if v.is_finite() {
+                v.clamp(lo, hi)
+            } else {
+                fallback
+            }
+        };
+        Slot {
+            dx: fix(self.dx, -MAX_MOVE, MAX_MOVE, 0.0),
+            dy: fix(self.dy, -MAX_MOVE, MAX_MOVE, 0.0),
+            scale: fix(self.scale, MIN_SCALE, MAX_SCALE, 1.0),
+            opacity: fix(self.opacity, MIN_OPACITY, 1.0, 1.0),
+            shown: self.shown,
+        }
+    }
+
+    /// The rectangle `base` (x, y, w, h in pixels) becomes in this arrangement, on a screen of
+    /// `size`, kept fully on the screen. The size changes around the centre.
+    pub fn place(&self, base: [f32; 4], size: (f32, f32)) -> [f32; 4] {
+        let s = self.clamped();
+        // Nothing changed: exactly the base, with none of the centre round trip's rounding.
+        if s.dx == 0.0 && s.dy == 0.0 && s.scale == 1.0 {
+            return base;
+        }
+        let [x, y, w, h] = base;
+        let (nw, nh) = (w * s.scale, h * s.scale);
+        let cx = x + w / 2.0 + s.dx * size.0;
+        let cy = y + h / 2.0 + s.dy * size.1;
+        // A button bigger than the screen cannot fit; the clamp order keeps its top left visible.
+        let nx = (cx - nw / 2.0).min(size.0 - nw).max(0.0);
+        let ny = (cy - nh / 2.0).min(size.1 - nh).max(0.0);
+        [nx, ny, nw, nh]
+    }
+
+    /// The nudge that moves a button from where `base` is to `target` (a rectangle in pixels,
+    /// usually one the player dragged to), so that `place(base)` gives `target` back.
+    pub fn moved_to(&self, base: [f32; 4], target: [f32; 4], size: (f32, f32)) -> Slot {
+        let s = self.clamped();
+        let (bx, by) = (base[0] + base[2] / 2.0, base[1] + base[3] / 2.0);
+        let (tx, ty) = (target[0] + target[2] / 2.0, target[1] + target[3] / 2.0);
+        Slot {
+            dx: if size.0 > 0.0 {
+                (tx - bx) / size.0
+            } else {
+                0.0
+            },
+            dy: if size.1 > 0.0 {
+                (ty - by) / size.1
+            } else {
+                0.0
+            },
+            ..s
+        }
+        .clamped()
+    }
+
+    /// Whether this is the default, which is not written to the file.
+    pub fn is_default(&self) -> bool {
+        *self == Slot::default()
+    }
+}
+
+/// The arrangement of every button.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ControlLayout {
+    pub slots: [Slot; COUNT],
+}
+
+impl Default for ControlLayout {
+    fn default() -> Self {
+        ControlLayout {
+            slots: [Slot::default(); COUNT],
+        }
+    }
+}
+
+impl ControlLayout {
+    /// The slot of the button at `index` into [`NAMES`]; the default for an index past the end.
+    pub fn slot(&self, index: usize) -> Slot {
+        self.slots.get(index).copied().unwrap_or_default().clamped()
+    }
+
+    pub fn is_default(&self) -> bool {
+        self.slots.iter().all(Slot::is_default)
+    }
+
+    /// Back to the default arrangement.
+    pub fn reset(&mut self) {
+        *self = ControlLayout::default();
+    }
+
+    /// One button back to its default.
+    pub fn reset_slot(&mut self, index: usize) {
+        if let Some(s) = self.slots.get_mut(index) {
+            *s = Slot::default();
+        }
+    }
+
+    /// Reads the file's text. Unknown names, malformed lines and out of range numbers are
+    /// ignored or brought into range, so a file edited by hand or from another version cannot
+    /// break touch or push a button off the screen.
+    pub fn parse(text: &str) -> Self {
+        let mut layout = ControlLayout::default();
+        for line in text.lines() {
+            let Some((name, rest)) = line.split_once(':') else {
+                continue;
+            };
+            let Some(index) = NAMES.iter().position(|n| *n == name.trim()) else {
+                continue;
+            };
+            let parts: Vec<&str> = rest.split(',').map(str::trim).collect();
+            if parts.len() != 5 {
+                continue;
+            }
+            let num = |i: usize| parts[i].parse::<f32>().ok();
+            let (Some(dx), Some(dy), Some(scale), Some(opacity)) = (num(0), num(1), num(2), num(3))
+            else {
+                continue;
+            };
+            let Ok(shown) = parts[4].parse::<bool>() else {
+                continue;
+            };
+            layout.slots[index] = Slot {
+                dx,
+                dy,
+                scale,
+                opacity,
+                shown,
+            }
+            .clamped();
+        }
+        layout
+    }
+
+    /// The file's text: only the buttons that differ from the default, so a layout nobody edited
+    /// writes nothing at all.
+    pub fn serialize(&self) -> String {
+        let mut out = String::new();
+        for (name, slot) in NAMES.iter().zip(&self.slots) {
+            if slot.is_default() {
+                continue;
+            }
+            let s = slot.clamped();
+            out.push_str(&format!(
+                "{name}:{:.4},{:.4},{:.3},{:.3},{}\n",
+                s.dx, s.dy, s.scale, s.opacity, s.shown
+            ));
+        }
+        out
+    }
+}
+
+/// How the Back button decides what it does and where it sits. Pure, so the rules are tested.
+pub mod back {
+    /// What a tap on Back does, from what is on screen.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub enum Effect {
+        /// A text box has the keyboard: put it away and stay on the screen.
+        CloseKeyboard,
+        /// Leave the screen: what Escape does.
+        Leave,
+    }
+
+    /// The first tap puts the keyboard away, and only the next leaves, so typing a message can be
+    /// paused without losing it.
+    pub fn effect(keyboard_open: bool) -> Effect {
+        if keyboard_open {
+            Effect::CloseKeyboard
+        } else {
+            Effect::Leave
+        }
+    }
+
+    /// The button's size as fractions of the screen, and its gap from the top left corner.
+    pub const WIDTH: f32 = 0.11;
+    pub const HEIGHT: f32 = 0.13;
+    pub const INSET_X: f32 = 0.02;
+    pub const INSET_Y: f32 = 0.04;
+
+    /// Back as `[x, y, w, h]` in pixels on a screen of `size`.
+    pub fn rect(size: (f32, f32)) -> [f32; 4] {
+        [
+            size.0 * INSET_X,
+            size.1 * INSET_Y,
+            size.0 * WIDTH,
+            size.1 * HEIGHT,
+        ]
+    }
+
+    /// A finger that went down on Back fires it when it lifts on Back too: a brush past the
+    /// corner, or a drag that began there and left, closes nothing.
+    pub fn fires(down_on_back: bool, up_at: (f32, f32), rect: [f32; 4]) -> bool {
+        down_on_back
+            && up_at.0 >= rect[0]
+            && up_at.0 < rect[0] + rect[2]
+            && up_at.1 >= rect[1]
+            && up_at.1 < rect[1] + rect[3]
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn the_first_tap_puts_the_keyboard_away_and_the_next_leaves() {
+            assert_eq!(effect(true), Effect::CloseKeyboard);
+            assert_eq!(effect(false), Effect::Leave);
+        }
+
+        #[test]
+        fn it_is_a_thumb_sized_target_in_the_corner_on_a_phone() {
+            let r = rect((2532.0, 1170.0));
+            assert!(r[2] >= 200.0 && r[3] >= 120.0, "{r:?}");
+            assert!(r[0] > 0.0 && r[1] > 0.0);
+            assert!(r[0] + r[2] < 2532.0 / 4.0 && r[1] + r[3] < 1170.0 / 4.0);
+        }
+
+        #[test]
+        fn lifting_on_the_button_fires_and_lifting_elsewhere_does_not() {
+            let r = rect((1000.0, 500.0));
+            let inside = (r[0] + 1.0, r[1] + 1.0);
+            assert!(fires(true, inside, r));
+            assert!(!fires(true, (900.0, 400.0), r), "dragged away");
+            assert!(!fires(false, inside, r), "never went down on it");
+            assert!(
+                !fires(true, (r[0] + r[2], r[1]), r),
+                "the far edge is outside"
+            );
+        }
+
+        #[test]
+        fn it_does_not_cover_the_inventory_it_closes() {
+            // The inventory panel is centred; the button stays in the corner outside its
+            // middle fifth of the width.
+            let r = rect((2532.0, 1170.0));
+            assert!(r[0] + r[2] < 2532.0 * 0.4);
+        }
+    }
+}
