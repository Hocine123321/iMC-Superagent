+            Item::AutoSprint => "autoSprint",
+            Item::ShiftX => "shiftX",
+            Item::ShiftY => "shiftY",
+            Item::SafeMargin => "safeMargin",
+            Item::AutoPerformance => "autoPerformance",
+            Item::AutoSensitivity => "autoSensitivity",
