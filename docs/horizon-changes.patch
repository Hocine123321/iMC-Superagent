+    }
+
+    /// The English tooltip.
+    pub fn description(self) -> &'static str {
+        match self {
+            Item::Controls => "Show the buttons on the screen while you play.",
+            Item::LookSpeed => "How far the view turns when you drag a finger across the world.",
