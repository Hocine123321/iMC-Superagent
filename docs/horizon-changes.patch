+        assert!(near(t.stick()[0], 1.0));
+        // Turning back by one radius now reverses the stick, which the fixed origin would not.
+        t.moved(1, (300.0 + radius * 2.0, 800.0), 0.2);
+        assert!(near(t.stick()[0], 0.0), "{:?}", t.stick());
+    }
+
+    #[test]
+    fn a_thumb_inside_full_travel_leaves_the_origin_where_it_landed() {
+        let mut t = touch();
+        t.down(1, (300.0, 800.0), 0.0, &[]);
+        let radius = t.layout.stick_radius * 1170.0;
+        t.moved(1, (300.0 + radius * 0.7, 800.0), 0.1);
+        assert_eq!(t.stick_origin(), Some((300.0, 800.0)));
+    }
+
+    #[test]
+    fn forward_at_the_edge_sprints_and_it_does_not_flicker() {
+        let mut t = touch();
+        t.down(1, (300.0, 800.0), 0.0, &[]);
+        let radius = t.layout.stick_radius * 1170.0;
+        // Forward is up the screen (y down is negative here).
+        t.moved(1, (300.0, 800.0 - radius), 0.1);
+        assert!(t.sprinting());
+        // Easing to 85% keeps it: that is between the two lines.
+        t.moved(1, (300.0, 800.0 - radius * 0.88), 0.2);
+        assert!(t.sprinting(), "{:?}", t.stick());
+        // Easing further lets go.
+        t.moved(1, (300.0, 800.0 - radius * 0.6), 0.3);
+        assert!(!t.sprinting());
+        // And 85% alone, from rest, does not start it.
+        t.moved(1, (300.0, 800.0 - radius * 0.88), 0.4);
+        assert!(!t.sprinting());
+    }
+
+    #[test]
+    fn backward_and_sideways_never_sprint() {
+        let mut t = touch();
+        t.down(1, (300.0, 800.0), 0.0, &[]);
+        let radius = t.layout.stick_radius * 1170.0;
+        t.moved(1, (300.0, 800.0 + radius), 0.1);
+        assert!(!t.sprinting(), "backward");
+        t.moved(1, (300.0 + radius, 800.0), 0.2);
+        assert!(!t.sprinting(), "sideways");
+    }
+
+    #[test]
+    fn lifting_the_steering_finger_stops_the_sprint() {
+        let mut t = touch();
+        t.down(1, (300.0, 800.0), 0.0, &[]);
+        let radius = t.layout.stick_radius * 1170.0;
+        t.moved(1, (300.0, 800.0 - radius), 0.1);
+        assert!(t.sprinting());
+        t.up(1, 0.2);
+        assert!(!t.sprinting());
+        t.down(2, (300.0, 800.0), 0.3, &[]);
+        t.moved(2, (300.0, 800.0 - radius), 0.4);
+        t.cancel_all();
+        assert!(!t.sprinting());
+    }
+}
diff --git a/horizon/crates/horizon-client-input/src/touch_calibration.rs b/horizon/crates/horizon-client-input/src/touch_calibration.rs
new file mode 100644
index 0000000..8a0fa97
--- /dev/null
+++ b/horizon/crates/horizon-client-input/src/touch_calibration.rs
@@ -0,0 +1,260 @@
+//! Touch calibration: a correction fitted from the player's own taps.
+//!
+//! The player taps targets the game draws; each pair (where the finger was reported, where the
+//! target is) is a sample. A stretch and a shift per axis, `x' = sx * x + ox`, is fitted to the
+//! samples by least squares and applied to every touch before anything else reads it. This
+//! corrects an error that grows toward the screen's edges (a touch reported a little toward the
+//! centre, more at the far left and far right) as well as a plain shift, whatever its cause.
+//!
+//! Pure: no window, no files except the text form. The screen that collects the taps is in
+//! `horizon-client`.
+
+/// The file the correction is kept in, beside the options.
+pub const FILE: &str = "horizon-imc-touch-calibration.txt";
+
+/// Where the targets are, as fractions of the screen: the four corners pulled in, and the centre.
+/// Far apart on purpose: the stretch is read from the distance between them.
+pub const TARGETS: [(f32, f32); 5] = [
+    (0.10, 0.12),
+    (0.90, 0.12),
+    (0.10, 0.88),
+    (0.90, 0.88),
+    (0.50, 0.50),
+];
+
+/// A stretch and a shift for each axis. The default does nothing.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Calibration {
+    pub sx: f32,
+    pub ox: f32,
+    pub sy: f32,
+    pub oy: f32,
+}
+
+impl Default for Calibration {
+    fn default() -> Self {
+        Self::IDENTITY
+    }
+}
+
+/// The most a fitted stretch may differ from 1 and the most a shift may move a touch (as a
+/// fraction of the screen). A bad run (a finger that missed a target) is refused, not applied.
+const MAX_STRETCH: f32 = 0.15;
+const MAX_SHIFT: f32 = 0.10;
+
+impl Calibration {
+    pub const IDENTITY: Self = Self {
+        sx: 1.0,
+        ox: 0.0,
+        sy: 1.0,
+        oy: 0.0,
+    };
+
+    pub fn is_identity(&self) -> bool {
+        *self == Self::IDENTITY
+    }
+
+    /// A reported touch as the finger really was.
+    pub fn apply(&self, at: (f32, f32)) -> (f32, f32) {
+        (self.sx * at.0 + self.ox, self.sy * at.1 + self.oy)
+    }
+
+    /// Fits the correction from `(reported, intended)` pairs on a screen of `size`, in pixels.
+    /// `None` when there are too few samples, they do not spread over the screen, or the result
+    /// is larger than any real error could be.
+    pub fn fit(samples: &[((f32, f32), (f32, f32))], size: (f32, f32)) -> Option<Self> {
+        if samples.len() < 3 || size.0 <= 0.0 || size.1 <= 0.0 {
+            return None;
+        }
+        let (sx, ox) = line(samples.iter().map(|s| (s.0.0, s.1.0)))?;
+        let (sy, oy) = line(samples.iter().map(|s| (s.0.1, s.1.1)))?;
+        let fitted = Self { sx, ox, sy, oy };
+        let fine = |s: f32, o: f32, extent: f32| {
+            s.is_finite()
+                && o.is_finite()
+                && (s - 1.0).abs() <= MAX_STRETCH
+                && o.abs() <= MAX_SHIFT * extent
+        };
+        (fine(sx, ox, size.0) && fine(sy, oy, size.1)).then_some(fitted)
+    }
+
+    /// The saved text: four numbers on one line.
+    pub fn to_text(&self) -> String {
+        format!("{:.6},{:.4},{:.6},{:.4}\n", self.sx, self.ox, self.sy, self.oy)
+    }
+
+    /// The saved text back. Anything unreadable or out of range is no correction.
+    pub fn parse(text: &str) -> Self {
+        let n: Vec<f32> = text
+            .trim()
+            .split(',')
+            .filter_map(|v| v.trim().parse().ok())
+            .collect();
+        match n.as_slice() {
+            [sx, ox, sy, oy]
+                if [sx, ox, sy, oy].iter().all(|v| v.is_finite())
+                    && (sx - 1.0).abs() <= MAX_STRETCH
+                    && (sy - 1.0).abs() <= MAX_STRETCH
+                    && ox.abs() <= 400.0
+                    && oy.abs() <= 400.0 =>
+            {
+                Self {
+                    sx: *sx,
+                    ox: *ox,
+                    sy: *sy,
+                    oy: *oy,
+                }
+            }
+            _ => Self::IDENTITY,
+        }
+    }
+}
+
+/// The target in pixels for target `i` on a screen of `size`.
+pub fn target(i: usize, size: (f32, f32)) -> (f32, f32) {
+    let t = TARGETS[i.min(TARGETS.len() - 1)];
+    (t.0 * size.0, t.1 * size.1)
+}
+
+/// Least squares for `y = s * x + o` over `(x, y)` pairs. `None` if all `x` are the same.
+fn line(pairs: impl Iterator<Item = (f32, f32)>) -> Option<(f32, f32)> {
+    let (mut n, mut sx, mut sy, mut sxx, mut sxy) = (0.0f64, 0.0f64, 0.0f64, 0.0f64, 0.0f64);
+    for (x, y) in pairs {
+        let (x, y) = (f64::from(x), f64::from(y));
+        n += 1.0;
+        sx += x;
+        sy += y;
+        sxx += x * x;
+        sxy += x * y;
+    }
+    let d = n * sxx - sx * sx;
+    // The taps must differ along the axis, or no stretch can be read from them.
+    if n < 2.0 || d.abs() < 1e-6 * n * n.max(1.0) {
+        return None;
+    }
+    let s = (n * sxy - sx * sy) / d;
+    let o = (sy - s * sx) / n;
+    Some((s as f32, o as f32))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const PHONE: (f32, f32) = (2532.0, 1170.0);
+
+    /// What the finger reported for each target, given a made-up error.
+    fn taps(error: impl Fn((f32, f32)) -> (f32, f32)) -> Vec<((f32, f32), (f32, f32))> {
+        (0..TARGETS.len())
+            .map(|i| {
+                let t = target(i, PHONE);
+                (error(t), t)
+            })
+            .collect()
+    }
+
+    fn close(a: (f32, f32), b: (f32, f32), tol: f32) -> bool {
+        (a.0 - b.0).abs() <= tol && (a.1 - b.1).abs() <= tol
+    }
+
+    #[test]
+    fn exact_taps_need_no_correction() {
+        let c = Calibration::fit(&taps(|t| t), PHONE).unwrap();
+        assert!((c.sx - 1.0).abs() < 1e-4 && (c.sy - 1.0).abs() < 1e-4, "{c:?}");
+        assert!(c.ox.abs() < 0.05 && c.oy.abs() < 0.05, "{c:?}");
+    }
+
+    #[test]
+    fn a_pull_toward_the_centre_is_undone() {
+        // The reported report: far left lands a little right, far right a little left. Here 3%
+        // toward the centre, which is 38 px at the far left of an iPhone 12.
+        let centre = (PHONE.0 / 2.0, PHONE.1 / 2.0);
+        let pulled = |t: (f32, f32)| {
+            (
+                centre.0 + (t.0 - centre.0) * 0.97,
+                centre.1 + (t.1 - centre.1) * 0.97,
+            )
+        };
+        let c = Calibration::fit(&taps(pulled), PHONE).unwrap();
+        for i in 0..TARGETS.len() {
+            let t = target(i, PHONE);
+            assert!(close(c.apply(pulled(t)), t, 0.5), "target {i}: {c:?}");
+        }
+        // Also at a point that was not a target.
+        let p = (60.0, 1100.0);
+        assert!(close(c.apply(pulled(p)), p, 0.5));
+        assert!(c.sx > 1.0, "the stretch grows the touch back out: {c:?}");
+    }
+
+    #[test]
+    fn a_plain_shift_is_undone_too() {
+        let shifted = |t: (f32, f32)| (t.0 + 14.0, t.1 - 9.0);
+        let c = Calibration::fit(&taps(shifted), PHONE).unwrap();
+        assert!((c.sx - 1.0).abs() < 1e-4);
+        assert!(close(c.apply(shifted((500.0, 500.0))), (500.0, 500.0), 0.05));
+    }
+
+    #[test]
+    fn the_two_axes_are_fitted_separately() {
+        let odd = |t: (f32, f32)| (t.0 * 1.02 + 5.0, t.1 * 0.98 - 3.0);
+        let c = Calibration::fit(&taps(odd), PHONE).unwrap();
+        for i in 0..TARGETS.len() {
+            let t = target(i, PHONE);
+            assert!(close(c.apply(odd(t)), t, 0.5));
+        }
+    }
+
+    #[test]
+    fn tap_noise_is_averaged_not_copied() {
+        // A few pixels of wobble on each tap: the fit stays close to the truth.
+        let wobble = [(2.0, -1.0), (-3.0, 2.0), (1.0, 3.0), (-2.0, -2.0), (0.0, 1.0)];
+        let samples: Vec<_> = (0..5)
+            .map(|i| {
+                let t = target(i, PHONE);
+                ((t.0 + wobble[i].0, t.1 + wobble[i].1), t)
+            })
+            .collect();
+        let c = Calibration::fit(&samples, PHONE).unwrap();
+        assert!((c.sx - 1.0).abs() < 0.005 && (c.sy - 1.0).abs() < 0.005, "{c:?}");
+    }
+
+    #[test]
+    fn too_few_or_bunched_taps_give_nothing() {
+        assert!(Calibration::fit(&[], PHONE).is_none());
+        let two = &taps(|t| t)[..2];
+        assert!(Calibration::fit(two, PHONE).is_none());
+        // Every tap at the same spot: nothing to read a stretch from.
+        let same: Vec<_> = (0..5).map(|_| ((100.0, 100.0), (100.0, 100.0))).collect();
+        assert!(Calibration::fit(&same, PHONE).is_none());
+    }
+
+    #[test]
+    fn a_missed_target_is_refused_not_applied() {
+        // One tap a third of the screen away: not a calibration error, a mistake.
+        let mut s = taps(|t| t);
+        s[0].0 = (s[0].0.0 + 800.0, s[0].0.1);
+        assert!(Calibration::fit(&s, PHONE).is_none());
+    }
+
+    #[test]
+    fn it_survives_the_file() {
+        let c = Calibration {
+            sx: 1.031_25,
+            ox: -37.5,
+            sy: 0.987_5,
+            oy: 12.25,
+        };
+        let back = Calibration::parse(&c.to_text());
+        assert!((back.sx - c.sx).abs() < 1e-5 && (back.ox - c.ox).abs() < 1e-3);
+        assert!((back.sy - c.sy).abs() < 1e-5 && (back.oy - c.oy).abs() < 1e-3);
+    }
+
+    #[test]
+    fn a_damaged_file_is_no_correction() {
+        for bad in ["", "x", "1,2,3", "1,0,1,0,9", "nan,0,1,0", "5,0,1,0", "1,9999,1,0"] {
+            assert_eq!(Calibration::parse(bad), Calibration::IDENTITY, "{bad:?}");
+        }
+        assert!(Calibration::default().is_identity());
+        assert_eq!(Calibration::IDENTITY.apply((10.0, 20.0)), (10.0, 20.0));
+    }
+}
diff --git a/horizon/crates/horizon-client-input/src/touch_cursor.rs b/horizon/crates/horizon-client-input/src/touch_cursor.rs
new file mode 100644
index 0000000..bf8f2a7
--- /dev/null
+++ b/horizon/crates/horizon-client-input/src/touch_cursor.rs
@@ -0,0 +1,699 @@
+//! Cursor mode: the finger is a trackpad and a real pointer moves on the screen.
+//!
+//! Plain touch puts the pointer under the finger, so the finger covers what it aims at and a
+//! small slot in a big inventory is hard to hit. Here the finger moves the pointer by how far it
+//! travels, as a laptop's trackpad does: the pointer stays where it was when a finger lands,
+//! the thumb can rest anywhere, and the pointer is drawn so the player sees exactly what a tap
+//! will press.
+//!
+//! - **Drag** one finger: the pointer moves by the finger's travel times [`Cursor::speed`].
+//! - **Tap** (short, little travel): a left click where the pointer is.
+//! - **Hold still** a moment: a right click, held until the finger lifts (the inventory's split).
+//! - **Tap, then touch again and drag** quickly: the left button goes down and the pointer drags
+//!   with it (a slider's knob, a stack across the inventory), and goes up when the finger lifts.
+//! - **Two fingers** moving up or down scroll.
+//!
+//! Pure logic with no winit types, so it runs under `cargo test`. It speaks the same [`Action`]s
+//! as [`crate::touch::Touch`] in a menu, so the game feeds them through the same pointer path.
+
+use crate::touch::{Action, FingerId};
+use std::collections::HashMap;
+
+/// How many pixels of finger travel scroll one line (as plain touch does).
+const PIXELS_PER_LINE: f32 = 40.0;
+
+/// Where the cursor starts when a screen opens, as fractions of the screen.
+const START: (f32, f32) = (0.5, 0.5);
+
+/// The speeds the player can pick: how many pixels the pointer moves for each pixel of finger.
+pub const SPEEDS: [f32; 5] = [0.6, 0.8, 1.0, 1.4, 2.0];
+pub const SPEED_NAMES: [&str; 5] = ["Slowest", "Slow", "Normal", "Fast", "Fastest"];
+/// The index of the normal speed.
+pub const NORMAL_SPEED: u8 = 2;
+
+/// Which screens the cursor takes over by itself when "Cursor in inventory" is on. The caller
+/// decides what is an inventory; this is what it says back to the game.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Source {
+    /// Not in use: plain touch.
+    Off,
+    /// The player switched to it with the button.
+    Switched,
+    /// An inventory opened and the setting asked for it. Plain touch returns when it closes.
+    Automatic,
+}
+
+impl Source {
+    pub fn active(self) -> bool {
+        self != Source::Off
+    }
+}
+
+/// Whether the cursor should be in use, from the player's switch and the screen.
+///
+/// - `switched`: the player pressed the cursor/touch button (it holds across screens).
+/// - `auto_inventory`: the setting "Cursor in inventory".
+/// - `in_inventory`: the open screen is an inventory-type one (the inventory, chests, crafting,
+///   creative).
+///
+/// The switch always wins when it is on. When it is off, an inventory brings the cursor up only
+/// if the setting asks for it, and the cursor goes away again with the screen.
+pub fn source_for(switched: bool, auto_inventory: bool, in_inventory: bool) -> Source {
+    if switched {
+        Source::Switched
+    } else if auto_inventory && in_inventory {
+        Source::Automatic
+    } else {
+        Source::Off
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Role {
+    /// The only finger down so far: moves the pointer, or clicks.
+    Pointer,
+    /// A second finger: scrolls.
+    Scroll,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Finger {
+    start: (f32, f32),
+    at: (f32, f32),
+    since: f64,
+    /// Went further than the slop from where it landed.
+    moved: bool,
+    role: Role,
+    /// This touch began soon after a tap, so a drag holds the left button.
+    drag_armed: bool,
+}
+
+/// The state of cursor mode.
+#[derive(Clone, Debug)]
+pub struct Cursor {
+    screen: (f32, f32),
+    /// The pointer, in physical pixels.
+    pos: (f32, f32),
+    /// Pixels the pointer moves per pixel of finger.
+    pub speed: f32,
+    /// How far a finger may travel and still be a tap, in pixels.
+    pub slop: f32,
+    /// A tap is shorter than this many seconds.
+    pub tap_secs: f64,
+    /// A press held still this long is a right click.
+    pub long_press_secs: f64,
+    /// A touch that lands within this long of a tap's lift (and not far from it) is a tap-drag.
+    pub drag_window_secs: f64,
+    fingers: HashMap<FingerId, Finger>,
+    /// When the last tap lifted, for the tap-drag.
+    last_tap: Option<f64>,
+    /// The left button is held by a tap-drag.
+    left_down: Option<FingerId>,
+    /// The right button is held by a long press.
+    right_down: Option<FingerId>,
+    last_scroll_y: Option<f32>,
+    out: Vec<Action>,
+}
+
+impl Cursor {
+    pub fn new(screen: (f32, f32)) -> Self {
+        Cursor {
+            screen,
+            pos: (screen.0 * START.0, screen.1 * START.1),
+            speed: 1.0,
+            slop: 10.0,
+            tap_secs: 0.25,
+            long_press_secs: 0.45,
+            drag_window_secs: 0.30,
+            fingers: HashMap::new(),
+            last_tap: None,
+            left_down: None,
+            right_down: None,
+            last_scroll_y: None,
+            out: Vec::new(),
+        }
+    }
+
+    /// The screen changed size (a rotation): the pointer keeps its place as a fraction of it.
+    pub fn resize(&mut self, screen: (f32, f32)) {
+        if screen == self.screen || screen.0 <= 0.0 || screen.1 <= 0.0 {
+            return;
+        }
+        let fraction = (
+            self.pos.0 / self.screen.0.max(1.0),
+            self.pos.1 / self.screen.1.max(1.0),
+        );
+        self.screen = screen;
+        self.pos = self.clamp((fraction.0 * screen.0, fraction.1 * screen.1));
+    }
+
+    /// The pointer, in physical pixels.
+    pub fn position(&self) -> (f32, f32) {
+        self.pos
+    }
+
+    /// Puts the pointer somewhere (a screen opening, the player switching to the cursor).
+    pub fn place(&mut self, at: (f32, f32)) {
+        self.pos = self.clamp(at);
+    }
+
+    /// Puts the pointer back in the middle of the screen.
+    pub fn centre(&mut self) {
+        self.pos = (self.screen.0 * START.0, self.screen.1 * START.1);
+    }
+
+    /// Whether a button is held by the cursor now (a tap-drag or a long press).
+    pub fn holding(&self) -> bool {
+        self.left_down.is_some() || self.right_down.is_some()
+    }
+
+    fn clamp(&self, p: (f32, f32)) -> (f32, f32) {
+        (
+            p.0.clamp(0.0, (self.screen.0 - 1.0).max(0.0)),
+            p.1.clamp(0.0, (self.screen.1 - 1.0).max(0.0)),
+        )
+    }
+
+    /// A finger landed. The pointer does not move: only travel moves it.
+    pub fn down(&mut self, id: FingerId, at: (f32, f32), now: f64) -> Vec<Action> {
+        self.out.clear();
+        if self.fingers.contains_key(&id) {
+            return Vec::new();
+        }
+        let role = if self.fingers.values().any(|f| f.role == Role::Pointer) {
+            self.last_scroll_y = Some(at.1);
+            Role::Scroll
+        } else {
+            Role::Pointer
+        };
+        let drag_armed = role == Role::Pointer
+            && self
+                .last_tap
+                .is_some_and(|t| now - t <= self.drag_window_secs);
+        self.fingers.insert(
+            id,
+            Finger {
+                start: at,
+                at,
+                since: now,
+                moved: false,
+                role,
+                drag_armed,
+            },
+        );
+        // A second finger in the middle of a click turns it into a scroll, not a click.
+        if role == Role::Scroll {
+            for f in self.fingers.values_mut() {
+                f.moved = true;
+            }
+        }
+        // Park the pointer so the game's hover follows it from the first touch.
+        if role == Role::Pointer {
+            self.out.push(Action::PointerTo {
+                x: self.pos.0,
+                y: self.pos.1,
+            });
+        }
+        std::mem::take(&mut self.out)
+    }
+
+    /// A finger moved.
+    pub fn moved(&mut self, id: FingerId, at: (f32, f32), now: f64) -> Vec<Action> {
+        self.out.clear();
+        let Some(mut f) = self.fingers.get(&id).copied() else {
+            return Vec::new();
+        };
+        let (dx, dy) = (at.0 - f.at.0, at.1 - f.at.1);
+        let from_start = ((at.0 - f.start.0).powi(2) + (at.1 - f.start.1).powi(2)).sqrt();
+        f.at = at;
+        match f.role {
+            Role::Pointer => {
+                if !f.moved && from_start > self.slop {
+                    f.moved = true;
+                    // A tap-drag: the second touch, once it really moves, grabs.
+                    if f.drag_armed && self.left_down.is_none() {
+                        self.left_down = Some(id);
+                        self.out.push(Action::PointerLeft(true));
+                    }
+                }
+                if f.moved {
+                    // The travel that crossed the slop is spent on moving the pointer too, so
+                    // it does not feel like a dead zone: from the second the finger counts as
+                    // moving, every pixel counts.
+                    self.pos = self.clamp((self.pos.0 + dx * self.speed, self.pos.1 + dy * self.speed));
+                    self.out.push(Action::PointerTo {
+                        x: self.pos.0,
+                        y: self.pos.1,
+                    });
+                }
+                self.hold(id, &f, now);
+            }
+            Role::Scroll => {
+                if let Some(last) = self.last_scroll_y {
+                    let lines = (last - at.1) / PIXELS_PER_LINE;
+                    if lines.abs() >= 0.25 {
+                        self.out.push(Action::Scroll { lines: -lines });
+                        self.last_scroll_y = Some(at.1);
+                    }
+                }
+            }
+        }
+        self.fingers.insert(id, f);
+        std::mem::take(&mut self.out)
+    }
+
+    /// Time passing with no finger event: a finger held still becomes a right click.
+    pub fn tick(&mut self, now: f64) -> Vec<Action> {
+        self.out.clear();
+        let ids: Vec<FingerId> = self.fingers.keys().copied().collect();
+        for id in ids {
+            let f = self.fingers[&id];
+            if f.role == Role::Pointer {
+                self.hold(id, &f, now);
+            }
+        }
+        std::mem::take(&mut self.out)
+    }
+
+    fn hold(&mut self, id: FingerId, f: &Finger, now: f64) {
+        if !f.moved
+            && !f.drag_armed
+            && self.right_down.is_none()
+            && self.left_down.is_none()
+            && now - f.since >= self.long_press_secs
+        {
+            self.right_down = Some(id);
+            self.out.push(Action::PointerRight(true));
+        }
+    }
+
+    /// A finger lifted (or the system cancelled it). `cancelled` never clicks.
+    pub fn up(&mut self, id: FingerId, now: f64, cancelled: bool) -> Vec<Action> {
+        self.out.clear();
+        let Some(f) = self.fingers.remove(&id) else {
+            return Vec::new();
+        };
+        match f.role {
+            Role::Pointer => {
+                if self.right_down == Some(id) {
+                    self.right_down = None;
+                    self.out.push(Action::PointerRight(false));
+                } else if self.left_down == Some(id) {
+                    self.left_down = None;
+                    self.out.push(Action::PointerLeft(false));
+                    self.last_tap = None;
+                } else if !cancelled
+                    && !f.moved
+                    && !self.fingers.values().any(|o| o.role == Role::Scroll)
+                    && now - f.since < self.tap_secs
+                {
+                    // A tap: the press and the release where the pointer is.
+                    self.out.push(Action::PointerTo {
+                        x: self.pos.0,
+                        y: self.pos.1,
+                    });
+                    self.out.push(Action::PointerLeft(true));
+                    self.out.push(Action::PointerLeft(false));
+                    self.last_tap = Some(now);
+                } else {
+                    self.last_tap = None;
+                }
+            }
+            Role::Scroll => {
+                if !self.fingers.values().any(|o| o.role == Role::Scroll) {
+                    self.last_scroll_y = None;
+                }
+            }
+        }
+        // When the last pointer finger leaves, a scroll finger left over scrolls on its own
+        // no longer; it simply waits to lift.
+        std::mem::take(&mut self.out)
+    }
+
+    /// Let go of everything (a screen closed, the app went to the background, the mode changed).
+    pub fn cancel_all(&mut self) -> Vec<Action> {
+        let mut out = Vec::new();
+        if self.right_down.take().is_some() {
+            out.push(Action::PointerRight(false));
+        }
+        if self.left_down.take().is_some() {
+            out.push(Action::PointerLeft(false));
+        }
+        self.fingers.clear();
+        self.last_tap = None;
+        self.last_scroll_y = None;
+        out
+    }
+}
+
+/// The speed for a stored index, never out of range.
+pub fn speed_at(index: u8) -> f32 {
+    SPEEDS[usize::from(index).min(SPEEDS.len() - 1)]
+}
+
+/// Where the cursor/touch switch sits and how it is hit: a small button, as fractions of the
+/// screen, under the Back button's corner so the two never overlap.
+pub mod switch {
+    pub const WIDTH: f32 = 0.11;
+    pub const HEIGHT: f32 = 0.11;
+    pub const INSET_X: f32 = 0.02;
+    /// Below Back (which starts at 4% and is 13% tall).
+    pub const INSET_Y: f32 = 0.19;
+
+    /// The button as `[x, y, w, h]` in pixels on a screen of `size`.
+    pub fn rect(size: (f32, f32)) -> [f32; 4] {
+        [
+            size.0 * INSET_X,
+            size.1 * INSET_Y,
+            size.0 * WIDTH,
+            size.1 * HEIGHT,
+        ]
+    }
+
+    /// A finger that went down on the switch toggles it when it lifts on it.
+    pub fn fires(down_on_it: bool, up_at: (f32, f32), rect: [f32; 4]) -> bool {
+        down_on_it
+            && up_at.0 >= rect[0]
+            && up_at.0 < rect[0] + rect[2]
+            && up_at.1 >= rect[1]
+            && up_at.1 < rect[1] + rect[3]
+    }
+
+    /// The caption: the mode a tap would switch TO.
+    pub fn caption(cursor_on: bool) -> &'static str {
+        if cursor_on { "Touch" } else { "Cursor" }
+    }
+}
