+            // Every key of the Key Binds page, and its resets.
+            Act::Key(_) | Act::ResetKey(_) | Act::ResetKeys => Some(crate::ios_unused::KEYBOARD),
+            _ => None,
+        },
+        WKind::Slider { opt, .. } => crate::ios_unused::opt(*opt),
+        _ => None,
+    }
